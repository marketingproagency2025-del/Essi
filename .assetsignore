# Cloudflare Workers Assets serves `assets.directory: "."`, i.e. the whole repo.
# Anything tracked in git and not listed here is publicly fetchable.
#
# .build/ holds internal working documents: the cut-over runbook, both proofread
# punch lists, the translation guides and translation-status.json. They are
# readable English prose about unpublished work and have no business being
# served at https://www.marketingpro-agency.com/.build/cutover.md
.build/

# Source images, ~28 MB. Gitignored today, so this is a second line of defence
# in case a .gitignore merge ever loses that rule.
originals/

# Repo metadata
.git/
.gitattributes
.gitignore

# Wrangler's own working directory: an account-id cache and temp build scaffolding.
# It does not exist until you run wrangler, which is why it was not here before -
# and the first deploy after a `wrangler login` published
# /.wrangler/cache/wrangler-account.json to the public site. Never again.
.wrangler/
